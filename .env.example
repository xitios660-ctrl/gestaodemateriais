# Banco
# mongodb = comportamento atual | sqlserver = SQL Server 2019+
DB_ENGINE=mongodb

# MongoDB (permanece disponível)
MONGO_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=gestao_materiais

# SQL Server 2019+ (usado somente quando DB_ENGINE=sqlserver)
SQLSERVER_SERVER=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=gestao_materiais
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_SCHEMA=dbo
SQLSERVER_TABLE_PREFIX=gm_
SQLSERVER_LOGIN_TIMEOUT=10
SQLSERVER_QUERY_TIMEOUT=30

# Segurança
JWT_SECRET=gere-uma-chave-forte-com-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
COOKIE_SECURE=true

# URL pública
FRONTEND_URL=https://seu-site.onrender.com
CORS_ORIGINS=https://seu-site.onrender.com

# Uploads
# Sem EMERGENT_LLM_KEY, os arquivos são gravados em STORAGE_DIR.
STORAGE_DIR=/app/data/uploads

# E-mail opcional (legado Emergent)
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Gestão de Materiais
DEFAULT_OWNER_EMAIL=responsavel@suaempresa.com
EMERGENT_LLM_KEY=
