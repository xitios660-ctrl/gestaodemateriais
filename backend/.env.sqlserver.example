# Ambiente alternativo para SQL Server 2019+
# Este arquivo é apenas modelo. Não coloque senha real no Git.
#
# Para ativar localmente, copie estes valores para backend/.env.
# Em produção (Render), configure as mesmas variáveis no painel do serviço.

DB_ENGINE=sqlserver
DB_NAME=gestao_materiais

# SQL Server 2019+
SQLSERVER_SERVER=SEU_SERVIDOR_OU_IP
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=gestao_materiais
SQLSERVER_USER=SEU_USUARIO
SQLSERVER_PASSWORD=SUA_SENHA
SQLSERVER_SCHEMA=dbo
SQLSERVER_TABLE_PREFIX=gm_
SQLSERVER_LOGIN_TIMEOUT=10
SQLSERVER_QUERY_TIMEOUT=30

# MongoDB permanece configurável para migração/retorno
MONGO_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# Segurança
JWT_SECRET=gere-uma-chave-forte-com-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
COOKIE_SECURE=true

# URL pública
FRONTEND_URL=https://seu-site.onrender.com
CORS_ORIGINS=https://seu-site.onrender.com

# Uploads
STORAGE_DIR=/app/data/uploads

# E-mail padrão
EMAIL_PROVIDER=auto
EMAIL_FROM_NAME=Gestão de Materiais
DEFAULT_OWNER_EMAIL=responsavel@suaempresa.com
EMERGENT_EMAIL_KEY=

# Alternativa opcional: SQL Server Database Mail
# Não é ativada por DB_ENGINE=sqlserver. A ativação é separada e explícita.
SQLSERVER_DBMAIL_ENABLED=false
SQLSERVER_DBMAIL_PROFILE=GestaoMateriais
SQLSERVER_DBMAIL_SERVER=SEU_SERVIDOR_OU_IP
SQLSERVER_DBMAIL_PORT=1433
SQLSERVER_DBMAIL_USER=SEU_USUARIO_DBMAIL
SQLSERVER_DBMAIL_PASSWORD=SUA_SENHA_DBMAIL
SQLSERVER_DBMAIL_LOGIN_TIMEOUT=10
SQLSERVER_DBMAIL_QUERY_TIMEOUT=30

EMERGENT_LLM_KEY=
