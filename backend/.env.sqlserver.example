# Ambiente alternativo para SQL Server 2012+
# Não coloque usuário, senha ou chave mestra reais no Git.

DB_ENGINE=sqlserver
DB_NAME=gestao_materiais

SQLSERVER_SERVER=SEU_SERVIDOR_OU_IP
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=gestao_materiais
SQLSERVER_SCHEMA=dbo
SQLSERVER_TABLE_PREFIX=gm_

# Microsoft ODBC 17/18. Para SQL Server 2012, priorizar 17.
SQLSERVER_ODBC_DRIVER=auto
SQLSERVER_ODBC_DRIVER_PREFERENCE=17,18
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_LOGIN_TIMEOUT=10
SQLSERVER_QUERY_TIMEOUT=30
SQLSERVER_AUTH_MODE=sql
SQLSERVER_REQUIRE_ENCRYPTED_CREDENTIALS=true
SQLSERVER_ALLOW_UNSUPPORTED_DRIVER=false

# Credenciais criptografadas
APP_CREDENTIAL_MASTER_KEY_FILE=E:\CAMINHO_PROTEGIDO\gestao-materiais.key
# APP_CREDENTIAL_MASTER_KEY=
SQLSERVER_USER_ENCRYPTED=ENCv1:SUBSTITUA_PELO_TOKEN_GERADO
SQLSERVER_PASSWORD_ENCRYPTED=ENCv1:SUBSTITUA_PELO_TOKEN_GERADO

# MongoDB permanece disponível para migração/retorno
MONGO_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# Segurança
JWT_SECRET=gere-uma-chave-forte-com-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
COOKIE_SECURE=true

FRONTEND_URL=https://seu-site.onrender.com
CORS_ORIGINS=https://seu-site.onrender.com
STORAGE_DIR=/app/data/uploads

# E-mail padrão
EMAIL_PROVIDER=auto
EMAIL_FROM_NAME=Gestão de Materiais
DEFAULT_OWNER_EMAIL=responsavel@suaempresa.com
EMERGENT_EMAIL_KEY=

# Alternativa opcional: SQL Server Database Mail
SQLSERVER_DBMAIL_ENABLED=false
SQLSERVER_DBMAIL_PROFILE=GestaoMateriais
SQLSERVER_DBMAIL_SERVER=SEU_SERVIDOR_OU_IP
SQLSERVER_DBMAIL_PORT=1433
SQLSERVER_DBMAIL_ODBC_DRIVER=auto
SQLSERVER_DBMAIL_ENCRYPT=no
SQLSERVER_DBMAIL_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_DBMAIL_AUTH_MODE=sql
SQLSERVER_DBMAIL_REQUIRE_ENCRYPTED_CREDENTIALS=true
SQLSERVER_DBMAIL_USER_ENCRYPTED=ENCv1:SUBSTITUA_PELO_TOKEN_GERADO
SQLSERVER_DBMAIL_PASSWORD_ENCRYPTED=ENCv1:SUBSTITUA_PELO_TOKEN_GERADO

EMERGENT_LLM_KEY=
